# WildLens backend settings. Copy to backend/.env (gitignored) and uncomment what you need:
#   cp backend/.env.example backend/.env
# Read by the backend in both run modes (`make dev` and `docker compose up`, via env_file).
# Every variable is optional; the values shown are the defaults. Never commit real keys.
# Relative paths resolve against the repository root (/srv inside the Docker image).

# --- Chat LLM ------------------------------------------------------------------------------------
# Without a key the Field Guide still answers, with a clearly labelled retrieval-only answer.
# Free Groq key, no card: https://console.groq.com/keys
# Set either line (blank values count as unset; WILDLENS_GROQ_API_KEY wins if both are set).
WILDLENS_GROQ_API_KEY=
# GROQ_API_KEY=
# Any Groq chat model id. openai/gpt-oss-20b is the default; openai/gpt-oss-120b is stronger.
# WILDLENS_GROQ_MODEL=openai/gpt-oss-20b
# WILDLENS_GROQ_BASE_URL=https://api.groq.com/openai/v1
# Wait before the single retry on 429/5xx (seconds).
# WILDLENS_GROQ_RETRY_DELAY_S=1.0

# Local Ollama, used after Groq (optional, offline LLM). Empty = disabled.
# From Docker, a host Ollama is http://host.docker.internal:11434.
WILDLENS_OLLAMA_URL=
# WILDLENS_OLLAMA_MODEL=llama3.2

# --- Chat limits and timeouts --------------------------------------------------------------------
# Requests per minute per client IP (in memory; 0 disables).
# WILDLENS_CHAT_RATE_LIMIT_PER_MINUTE=20
# Messages per request / characters per user message / request body size (KB).
# WILDLENS_CHAT_MAX_MESSAGES=20
# WILDLENS_CHAT_MAX_MESSAGE_CHARS=2000
# WILDLENS_CHAT_MAX_BODY_KB=64
# Earlier answers are trimmed to this many characters before they go back to the LLM.
# WILDLENS_CHAT_MAX_ASSISTANT_CHARS=1500
# Only the last N messages are sent to the LLM.
# WILDLENS_CHAT_HISTORY_MESSAGES=10
# Maximum tokens the LLM may generate per answer.
# WILDLENS_CHAT_MAX_TOKENS=700
# Total budget for one answer, live-lookup budget, and per-request LLM timeouts (seconds).
# WILDLENS_CHAT_TIMEOUT_S=45
# WILDLENS_RETRIEVAL_TIMEOUT_S=10
# WILDLENS_LLM_CONNECT_TIMEOUT_S=5
# WILDLENS_LLM_READ_TIMEOUT_S=20
# Look up animals outside the 80 classes on Wikipedia/Wikidata/iNaturalist (false = offline only).
# WILDLENS_CHAT_LIVE_LOOKUP=true

# --- Identification ------------------------------------------------------------------------------
# Upload limit (MB) and decoded-pixel limit (decompression-bomb guard).
# WILDLENS_MAX_UPLOAD_MB=10
# WILDLENS_MAX_IMAGE_PIXELS=50000000
# Predictions whose top-1 probability is below this are flagged as low confidence.
# WILDLENS_LOW_CONFIDENCE_THRESHOLD=0.5
# ONNX Runtime threads per request (0 = min(4, CPU count)).
# WILDLENS_INTRA_OP_THREADS=0
# Longest side of the heatmap PNGs, and heatmap opacity in overlay_png.
# WILDLENS_EXPLAIN_MAX_SIDE=1024
# WILDLENS_OVERLAY_ALPHA=0.45

# --- Server ----------------------------------------------------------------------------------------
# Comma-separated origins allowed to call the API from another origin. `make dev` uses the Vite
# proxy and Docker serves the site and API on one origin, so this only matters for custom setups.
# (docker-compose.yml sets http://localhost:8080,http://127.0.0.1:8080 for the container.)
# WILDLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Data locations --------------------------------------------------------------------------------
# WILDLENS_REGISTRY_PATH=models/registry.json
# WILDLENS_RESULTS_DIR=outputs/results
# WILDLENS_FIGURES_DIR=outputs/figures
# WILDLENS_SPECIES_KB_PATH=data/species_kb.json
# Offline photo cache built by `make cache-images` (missing = Wikimedia Commons thumbnails).
# WILDLENS_SPECIES_IMAGES_DIR=data/species_images
